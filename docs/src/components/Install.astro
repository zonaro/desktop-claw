---
import { Icon } from "astro-icon/components";
import { RELEASES_URL } from "../consts";

interface Download {
  /** The file to look for on the releases page. */
  file: string;
  /** Which machine it's for. */
  arch: string;
  note?: string;
}

interface Platform {
  id: string;
  label: string;
  icon: string;
  iconClass: string;
  heading: string;
  downloads: Download[];
  /** Extra guidance rendered below the table (may contain markup). */
  notes: string[];
}

const platforms: Platform[] = [
  {
    id: "windows",
    label: "Windows",
    // Windows' logo fills its whole viewBox, so it reads larger than the
    // others at the same box size; nudge it down to balance optically.
    icon: "simple-icons:windows",
    iconClass: "h-3.5 w-3.5",
    heading: "Windows 10 and 11",
    downloads: [
      { file: "<code>-windows-x64.exe</code>", arch: "64-bit x86", note: "Most PCs" },
      { file: "<code>-windows-arm64.exe</code>", arch: "64-bit ARM", note: "Snapdragon / ARM devices" },
    ],
    notes: [
      "Run the installer and you're done — no admin rights required.",
      "There's also an <code>.msi</code> build for enterprise deployment. It only registers a hook that installs the app at next login, so it needs a reboot to finish. Regular users should stick to the <code>.exe</code>.",
    ],
  },
  {
    id: "macos",
    label: "macOS",
    icon: "simple-icons:apple",
    iconClass: "h-4.5 w-4.5",
    heading: "macOS",
    downloads: [
      { file: "<code>-macOS-arm64.zip</code>", arch: "Apple Silicon", note: "M1 and newer" },
      { file: "<code>-macOS-x64.zip</code>", arch: "64-bit Intel" },
    ],
    notes: [
      "Unzip it and drag the app into your Applications folder.",
      "If macOS reports it can't verify the app, open <span class='text-fg-muted'>System Settings ➔ Privacy &amp; Security</span> and click “Open Anyway”.",
    ],
  },
  {
    id: "linux",
    label: "Linux",
    icon: "simple-icons:linux",
    iconClass: "h-4.5 w-4.5",
    heading: "Linux",
    downloads: [
      { file: "<code>.deb</code>", arch: "x86_64 · ARM64", note: "Debian, Ubuntu, Mint, Pop!_OS, Zorin, elementary OS" },
      { file: "<code>.rpm</code>", arch: "x86_64 · ARM64", note: "Fedora, RHEL, CentOS Stream, Rocky, AlmaLinux, openSUSE" },
      { file: "<code>.AppImage</code>", arch: "x86_64 · ARM64", note: "Any distro" },
    ],
    notes: [
      "<code>gnome-keyring</code> is required to store your credentials, and its daemon must be running at login.",
      "The AppImage needs to be marked as executable before it will run, and it takes some manual setup for sign-in to work: create a <code>desktop-claw.desktop</code> entry and point the <code>x-scheme-handler/x-github-desktop-auth</code> MIME type at it. Prefer the <code>.deb</code> or <code>.rpm</code> if your distro supports them.",
    ],
  },
];
---

<section id="install" class="scroll-mt-20 border-t border-border/60">
  <div class="mx-auto max-w-4xl px-5 py-20 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">Download Desktop Claw</h2>
      <p class="mt-4 text-balance text-fg-muted">
        Every build is published on GitHub Releases. Grab the file for your platform, install it, and you're running.
      </p>

      <a
        href={RELEASES_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand-900/40 transition hover:bg-brand-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400"
      >
        <Icon name="octicon:download-16" class="h-4.5 w-4.5" />
        Go to the latest release
      </a>
      <p class="mt-3 text-xs text-fg-subtle">Opens GitHub in a new tab</p>
    </div>

    <!-- OS tabs -->
    <div class="mt-12 flex flex-wrap justify-center gap-2" role="tablist" aria-label="Operating system">
      {
        platforms.map((os, i) => (
          <button
            type="button"
            role="tab"
            data-tab-group="os"
            data-tab={os.id}
            aria-selected={i === 0 ? "true" : "false"}
            class:list={[
              "os-tab inline-flex items-center gap-2 rounded-lg border px-4 py-2.5 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400",
              i === 0 ? "border-brand-500/60 bg-surface text-white hover:text-white" : "border-border text-fg-muted hover:text-white",
            ]}
          >
            <Icon name={os.icon} class={os.iconClass} />
            {os.label}
          </button>
        ))
      }
    </div>

    <div class="mt-8">
      {
        platforms.map((os, i) => (
          <div data-tab-group="os" data-panel={os.id} role="tabpanel" class:list={[i !== 0 && "hidden"]}>
            <div class="rounded-xl border border-border bg-surface/50 px-6 pb-6 pt-5 sm:px-8">
              <h3 class="mb-1 text-lg font-semibold text-white">{os.heading}</h3>
              <p class="mb-5 text-sm text-fg-subtle">Look for these files under “Assets” on the release.</p>

              <ul class="divide-y divide-border/60 overflow-hidden rounded-lg border border-border bg-canvas-inset">
                {os.downloads.map((d) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 py-3">
                    <span class="font-mono text-[13px] text-fg" set:html={d.file} />
                    <span class="text-sm text-fg-muted">
                      {d.arch}
                      {d.note && <span class="text-fg-subtle"> · {d.note}</span>}
                    </span>
                  </li>
                ))}
              </ul>

              <ul class="mt-5 space-y-3">
                {os.notes.map((n) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                    <Icon name="octicon:info-16" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" />
                    <span set:html={n} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-8 flex gap-3 rounded-xl border border-attention/25 bg-attention/5 px-5 py-4">
      <Icon name="octicon:alert-16" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-attention" />
      <p class="text-sm leading-relaxed text-fg-muted">
        <span class="font-medium text-fg">Desktop Claw doesn't update itself.</span> It isn't distributed through Winget, Homebrew, or any distro repository
        — check the <a
          href={RELEASES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-400 underline underline-offset-2 hover:text-brand-300">releases page</a
        > now and then, or watch the repository on GitHub to get notified about new versions.
      </p>
    </div>
  </div>
</section>

<script>
  function initTabs(group: string) {
    const tabs = document.querySelectorAll<HTMLElement>(`[data-tab-group="${group}"][data-tab]`);
    const panels = document.querySelectorAll<HTMLElement>(`[data-tab-group="${group}"][data-panel]`);
    const ON = ["border-brand-500/60", "bg-surface", "text-white"];
    const OFF = ["border-border", "text-fg-muted"];
    const names = new Set(Array.from(tabs, (t) => t.dataset.tab));

    function activate(name: string) {
      if (!names.has(name)) return;
      tabs.forEach((t) => {
        const on = t.dataset.tab === name;
        t.setAttribute("aria-selected", String(on));
        ON.forEach((c) => t.classList.toggle(c, on));
        OFF.forEach((c) => t.classList.toggle(c, !on));
      });
      panels.forEach((p) => {
        p.classList.toggle("hidden", p.dataset.panel !== name);
      });
    }

    tabs.forEach((t) => t.addEventListener("click", () => t.dataset.tab && activate(t.dataset.tab)));
    return activate;
  }

  const activateOS = initTabs("os");

  // Detect the visitor's platform and pre-select the matching tab. Falls back to
  // the server-rendered default (Windows) when detection is inconclusive.
  function detectOS(hay: string): string | null {
    if (/android/.test(hay)) return null; // app isn't for Android
    if (/win/.test(hay)) return "windows";
    if (/mac|iphone|ipad|ipod/.test(hay)) return "macos";
    if (/linux|x11|cros/.test(hay)) return "linux";
    return null;
  }

  const ua = navigator.userAgent.toLowerCase();
  const nav = navigator as Navigator & {
    userAgentData?: { platform?: string };
  };
  const platform = (nav.userAgentData?.platform || navigator.platform || "").toLowerCase();
  const os = detectOS(`${ua} ${platform}`);
  if (os) activateOS(os);
</script>
